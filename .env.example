# Everything is optional. Missing keys switch that feature into demo mode.

SECRET_KEY=change-me-to-a-long-random-string
# Your live address, e.g. https://glow-studio.up.railway.app. Leave empty locally.
BASE_URL=
ADMIN_PASSWORD=demo

# Leave empty to use an in-memory demo database (resets on restart).
MONGO_URI=
MONGO_DB=glow_studio

# Stripe test keys: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# resend.com
RESEND_API_KEY=
EMAIL_FROM=Glow Studio <onboarding@resend.dev>

# Slack incoming webhook URL
SLACK_WEBHOOK_URL=
